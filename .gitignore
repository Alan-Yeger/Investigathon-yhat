# Secrets
.env
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Inspect logs and large artifacts (keep curated results in results/)
logs/
*.eval

# Notebooks / OS
.ipynb_checkpoints/
.DS_Store

# Claude Code local state
.claude/scheduled_tasks.lock

# VSCode settings
/.vscode/
# Render de Quarto (se regenera con `quarto render`)
presentaciones/*.html
presentaciones/*_files/

# Clave del etiquetado a ciegas (qué modelo es cada fila). No subir hasta que los tres terminen de etiquetar;
# después se agrega con `git add -f results/etiquetado_piloto_clave.csv` y se borra esta línea.
results/etiquetado_piloto_clave.csv

# Generaciones crudas del test (decenas de MB). El resumen liviano va en results/test_resumen_juez.csv
results/test_gen*.jsonl

# Generaciones crudas del steering (decenas de MB); en el repo van los logs
results/steering_*.jsonl

# Respuestas crudas del benchmark de capacidad (35 MB). En el repo van capacidad.log y capacidad_resumen.csv
results/capacidad.jsonl

# Respaldo de la VM (adaptadores y resultados crudos, ~4 GB): nunca se versiona
respaldo-vm/

# Auxiliares de LaTeX del informe (el .tex, el .pdf y figs/ sí se versionan)
informe/*.aux
informe/*.log
informe/*.out
informe/*.toc
